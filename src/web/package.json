{
  "name": "synoptik-web",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -b packages/client packages/agents packages/server packages/agent-host",
    "e2e": "node e2e/run.mjs"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "@types/node": "22.10.2",
    "playwright-core": "1.49.1"
  }
}
